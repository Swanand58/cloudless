# Cloudless backend configuration for local development
# Copy this file to .env and customize. Production uses the root .env instead.

# Debug mode: enables /docs and allows running without a SECRET_KEY
DEBUG=true

# Required when DEBUG=false. Generate with: openssl rand -hex 32
SECRET_KEY=

# Password for the first "admin" account (random and logged once if empty)
ADMIN_PASSWORD=

# Database
DATABASE_URL=sqlite+aiosqlite:///./cloudless.db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_STORAGE_GB=20

# CORS - the dev frontend runs on its own port
CORS_ORIGINS=["http://localhost:3000"]
