# Cloudless deployment configuration
# Copy this file to .env and fill it in

# Required. Signs login sessions. Generate with: openssl rand -hex 32
SECRET_KEY=

# Optional. Password for the first "admin" account. If empty, a random one
# is generated and printed once in the backend logs on first start.
ADMIN_PASSWORD=

# Port on this machine where the app is served (http://localhost:8080)
PORT=8080

# Cloudflare tunnel ID (a UUID), printed by `cloudflared tunnel create cloudless`.
# Only needed with: docker compose --profile tunnel up -d
TUNNEL_ID=
